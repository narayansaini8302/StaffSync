NODE_ENV=production
PORT=4000
DATABASE_URL="postgresql://attendance_user:attendance_pass@localhost:55432/attendance_db?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="replace-with-random-32+-char-string-abcdef1234567890"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-different-random-32+-char-string"
JWT_REFRESH_EXPIRES_IN="7d"
BCRYPT_ROUNDS=12

# ============ SUPER ADMIN (Platform Owner) ============
SUPER_ADMIN_EMAIL="super@attendance.local"
SUPER_ADMIN_PASSWORD="ChangeMe123!"

# ============ EMAIL & SMTP CONFIGURATION (Nodemailer) ============
# For Gmail: Use an App Password (generated from Google Account > Security > 2-Step Verification > App passwords)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-google-app-password"
EMAIL_FROM_NAME="StaffSync Attendance & Payroll"
SMTP_FROM="your-email@gmail.com"

# ============ AWS S3 / OBJECT STORAGE (PDFs & Documents) ============
AWS_REGION="ap-south-1"
AWS_S3_BUCKET_NAME="your-s3-bucket-name"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
# Optional (for Cloudflare R2, MinIO, or custom endpoint):
# AWS_S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# AWS_S3_PUBLIC_DOMAIN="https://cdn.yourdomain.com"
