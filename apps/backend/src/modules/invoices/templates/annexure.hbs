<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8" />
<style>
  * { box-sizing: border-box; }
  body { font-family: -apple-system, "Segoe UI", Roboto, sans-serif; color: #1a1a1a; font-size: 11px; margin: 0; padding: 25px 30px; }
  h1 { font-size: 20px; margin: 0; color: #0D47A1; letter-spacing: 1px; }
  .header { border-bottom: 2px solid #0D47A1; padding-bottom: 12px; margin-bottom: 20px; }
  .header .meta { color: #555; font-size: 10px; line-height: 1.5; margin-top: 4px; }
  .header .right { text-align: right; font-size: 11px; line-height: 1.5; float: right; margin-top: -40px; }

  .summary-box { background: #f7fafd; padding: 12px 16px; border-radius: 5px; margin-bottom: 20px; display: flex; justify-content: space-between; }
  .summary-box .stat { text-align: center; }
  .summary-box .stat .label { font-size: 9px; text-transform: uppercase; color: #666; letter-spacing: 0.5px; }
  .summary-box .stat .value { font-size: 16px; font-weight: bold; color: #0D47A1; margin-top: 2px; }

  .category-block { margin-bottom: 24px; page-break-inside: avoid; }
  .category-title { font-size: 13px; font-weight: bold; color: #0D47A1; padding: 8px 12px; background: #E3F2FD; border-left: 4px solid #2196F3; margin-bottom: 0; border-radius: 4px 4px 0 0; }
  .category-title .count { font-weight: normal; font-size: 10px; color: #555; float: right; margin-top: 2px; }

  table { width: 100%; border-collapse: collapse; }
  th { background: #f5f7fa; color: #0D47A1; font-size: 9px; text-transform: uppercase; padding: 6px 10px; text-align: left; border-bottom: 1px solid #90CAF9; letter-spacing: 0.5px; }
  td { padding: 5px 10px; border-bottom: 1px solid #eee; font-size: 10px; }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
  tr:nth-child(even) td { background: #fbfcfe; }
  .subtotal-row td { background: #EEF5FB; font-weight: bold; border-top: 2px solid #90CAF9; border-bottom: none; }

  .grand-total-box { margin-top: 20px; padding: 14px 20px; background: #0D47A1; color: white; border-radius: 6px; text-align: right; }
  .grand-total-box .label { font-size: 11px; opacity: 0.85; letter-spacing: 1px; }
  .grand-total-box .value { font-size: 22px; font-weight: bold; margin-top: 2px; }

  .footer { margin-top: 30px; padding-top: 12px; border-top: 1px solid #ddd; font-size: 9px; color: #777; text-align: center; }
  .page-label { font-size: 10px; color: #666; text-align: center; margin-top: 8px; }
</style>
</head>
<body>

<div class="header">
  <div class="right">
    <div><strong>Annexure to Invoice</strong></div>
    <div>{{invoiceNumber}}</div>
    <div style="margin-top: 4px;">Period: {{periodStart}} to {{periodEnd}}</div>
  </div>
  <h1>EMPLOYEE-WISE BREAKDOWN</h1>
  <div class="meta">{{companyName}} → {{clientName}}</div>
</div>

<div class="summary-box">
  <div class="stat">
    <div class="label">Total Employees</div>
    <div class="value">{{totalEmployees}}</div>
  </div>
  <div class="stat">
    <div class="label">Total Hours</div>
    <div class="value">{{totalHours}}</div>
  </div>
  <div class="stat">
    <div class="label">Categories</div>
    <div class="value">{{categoryCount}}</div>
  </div>
  <div class="stat">
    <div class="label">Subtotal</div>
    <div class="value">₹{{subtotal}}</div>
  </div>
</div>

{{#each categories}}
<div class="category-block">
  <div class="category-title">
    {{this.label}}
    <span class="count">{{this.employeeCount}} employees · {{this.hours}} hours</span>
  </div>
  <table>
    <thead>
      <tr>
        <th style="width: 40px;">#</th>
        <th style="width: 90px;">Code</th>
        <th>Employee Name</th>
        <th class="num" style="width: 90px;">Hours</th>
        <th class="num" style="width: 100px;">Rate (₹/hr)</th>
        <th class="num" style="width: 130px;">Amount (₹)</th>
      </tr>
    </thead>
    <tbody>
      {{#each this.items}}
        <tr>
          <td>{{this.index}}</td>
          <td>{{this.employeeCode}}</td>
          <td>{{this.employeeName}}</td>
          <td class="num">{{this.hoursWorked}}</td>
          <td class="num">{{this.hourlyRate}}</td>
          <td class="num">{{this.amount}}</td>
        </tr>
      {{/each}}
      <tr class="subtotal-row">
        <td colspan="3" style="text-align: right;">{{this.label}} Subtotal</td>
        <td class="num">{{this.hours}}</td>
        <td></td>
        <td class="num">{{this.subtotal}}</td>
      </tr>
    </tbody>
  </table>
</div>
{{/each}}

<div class="grand-total-box">
  <div class="label">SUBTOTAL (excl. GST)</div>
  <div class="value">₹ {{subtotal}}</div>
</div>

<div class="footer">
  This annexure is a supporting document to Invoice {{invoiceNumber}} and does not substitute the invoice itself.
  <div class="page-label">Generated on {{generatedAt}}</div>
</div>

</body>
</html>