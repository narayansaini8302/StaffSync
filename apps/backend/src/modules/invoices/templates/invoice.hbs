<!DOCTYPE html>
<html>

<head>
  <meta charset="utf-8" />
  <style>
    @page {
      size: A4 portrait;
      margin: 8mm 10mm;
    }

    * {
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, "Segoe UI", Roboto, sans-serif;
      color: #1a1a1a;
      font-size: 10.5px;
      line-height: 1.35;
      margin: 0;
      padding: 0;
    }

    h1 {
      font-size: 20px;
      margin: 0 0 4px;
      letter-spacing: 1.5px;
    }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      border-bottom: 2.5px solid #0D47A1;
      padding-bottom: 8px;
      margin-bottom: 12px;
    }

    .header .left h1 {
      color: #0D47A1;
      margin-bottom: 4px;
    }

    .header .right {
      text-align: right;
      font-size: 11px;
      line-height: 1.45;
    }

    .meta {
      color: #4b5563;
      font-size: 10px;
      line-height: 1.35;
    }

    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-bottom: 12px;
    }

    .box {
      border: 1px solid #e2e8f0;
      padding: 8px 12px;
      border-radius: 5px;
      background: #fafbfc;
    }

    .box h2 {
      font-size: 10px;
      margin: 0 0 5px;
      text-transform: uppercase;
      color: #0D47A1;
      letter-spacing: 0.8px;
    }

    .box .line {
      margin-bottom: 2px;
      font-size: 10px;
      line-height: 1.35;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 8px;
    }

    th {
      background: #E3F2FD;
      color: #0D47A1;
      font-size: 9.5px;
      text-transform: uppercase;
      padding: 6px 10px;
      text-align: left;
      border-bottom: 2px solid #90CAF9;
      letter-spacing: 0.4px;
    }

    td {
      padding: 6px 10px;
      border-bottom: 1px solid #edf2f7;
      font-size: 10.5px;
    }

    td.num,
    th.num {
      text-align: right;
      font-variant-numeric: tabular-nums;
    }

    tr.line-item:nth-child(even) {
      background: #fbfcfe;
    }

    .totals {
      margin-left: auto;
      width: 320px;
      margin-top: 6px;
      page-break-inside: avoid;
    }

    .totals table td {
      padding: 4px 8px;
      font-size: 10.5px;
    }

    .totals .grand-total td {
      font-size: 14px;
      font-weight: bold;
      color: #0D47A1;
      border-top: 2px solid #0D47A1;
      padding-top: 6px;
    }

    .amount-words {
      margin-top: 8px;
      padding: 6px 10px;
      background: #f7fafd;
      border-left: 3px solid #2196F3;
      font-size: 10px;
      border-radius: 3px;
      page-break-inside: avoid;
    }

    .annexure-note {
      margin-top: 8px;
      padding: 6px 10px;
      background: #fff8e1;
      border-left: 3px solid #f0c040;
      font-size: 9.5px;
      border-radius: 3px;
      page-break-inside: avoid;
    }

    .footer {
      margin-top: 10px;
      padding-top: 8px;
      border-top: 1px solid #e2e8f0;
      font-size: 9px;
      color: #64748b;
      page-break-inside: avoid;
    }

    .footer .bank {
      margin-bottom: 4px;
      font-size: 9.5px;
      color: #334155;
    }

    .stamp {
      text-align: right;
      margin-top: 10px;
      font-size: 10px;
      page-break-inside: avoid;
    }

    .signature-line {
      display: inline-block;
      border-top: 1px solid #94a3b8;
      padding-top: 3px;
      min-width: 170px;
      margin-top: 6px;
    }
  </style>
</head>

<body>

  <div class="header">
    <div class="left">
      {{#if companyLogo}}
      <img src="http://localhost:4000{{companyLogo}}" alt="Logo" style="height: 50px; margin-bottom: 8px;" />
      {{/if}}
      <h1>{{#if invoiceTitle}}{{invoiceTitle}}{{else}}TAX INVOICE{{/if}}</h1>
      <div class="meta">{{companyName}}</div>
      {{#if companyGstin}}<div class="meta">GSTIN: {{companyGstin}}</div>{{/if}}
      <div class="meta">{{companyAddress}}</div>
      <div class="meta">State Code: {{companyState}}</div>
    </div>
    <div class="right">
      <div><strong>Invoice No:</strong> {{invoiceNumber}}</div>
      <div><strong>Date:</strong> {{issueDate}}</div>
      {{#if periodStart}}<div><strong>Period:</strong> {{periodStart}} to {{periodEnd}}</div>{{/if}}
      {{#if dueDate}}<div><strong>Due Date:</strong> {{dueDate}}</div>{{/if}}
    </div>
  </div>

  <div class="grid">
    <div class="box">
      <h2>Bill To</h2>
      <div class="line"><strong>{{clientName}}</strong></div>
      {{#if clientGstin}}<div class="line">GSTIN: {{clientGstin}}</div>{{/if}}
      <div class="line">{{clientAddress}}</div>
      {{#if clientState}}<div class="line">State Code: {{clientState}}</div>{{/if}}
      {{#if clientEmail}}<div class="line">{{clientEmail}}</div>{{/if}}
      {{#if clientPhone}}<div class="line">{{clientPhone}}</div>{{/if}}
    </div>
    <div class="box">
      <h2>{{#if isGeneralInvoice}}Invoice Summary{{else}}Attendance Summary{{/if}}</h2>
      {{#if isGeneralInvoice}}
      <div class="line">Total Line Items: <strong>{{totalItems}}</strong></div>
      <div class="line">Payment Status: <strong>{{invoiceStatus}}</strong></div>
      <div class="line" style="margin-top: 8px; color: #0D47A1;">
        <strong>Computer-generated general commercial invoice.</strong>
      </div>
      {{else}}
      <div class="line">Total Employees: <strong>{{totalEmployees}}</strong></div>
      <div class="line">Total Hours: <strong>{{totalHours}}</strong></div>
      <div class="line">Service Categories: <strong>{{categoryCount}}</strong></div>
      <div class="line" style="margin-top: 8px; color: #0D47A1;">
        <strong>Detailed employee-wise breakdown attached as Annexure.</strong>
      </div>
      {{/if}}
    </div>
  </div>

  <h3 style="font-size: 13px; margin: 0 0 10px; color: #0D47A1;">
    {{#if isGeneralInvoice}}Particulars / Description of Services{{else}}Description of Services{{/if}}
  </h3>

  {{#if isGeneralInvoice}}
  <table>
    <thead>
      <tr>
        <th style="width: 50px;">#</th>
        <th>Description / Service</th>
        <th class="num" style="width: 100px;">Qty / Hrs</th>
        <th class="num" style="width: 110px;">Rate (₹)</th>
        <th class="num" style="width: 130px;">Amount (₹)</th>
      </tr>
    </thead>
    <tbody>
      {{#each lineItemsList}}
      <tr class="line-item">
        <td>{{this.index}}</td>
        <td><strong>{{this.description}}</strong></td>
        <td class="num">{{this.quantity}}</td>
        <td class="num">₹ {{this.rate}}</td>
        <td class="num">₹ {{this.amount}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{else}}
  <table>
    <thead>
      <tr>
        <th style="width: 50px;">#</th>
        <th>Service Category</th>
        <th class="num" style="width: 100px;">Employees</th>
        <th class="num" style="width: 100px;">Hours</th>
        <th class="num" style="width: 110px;">Rate/Hr</th>
        <th class="num" style="width: 130px;">Amount</th>
      </tr>
    </thead>
    <tbody>
      {{#each categories}}
      <tr class="line-item">
        <td>{{this.index}}</td>
        <td>
          <strong>{{this.label}}</strong>
          {{#if this.range}}
          <div style="font-size: 10px; color: #666; margin-top: 2px;">
            ({{this.range}})
          </div>
          {{/if}}
        </td>
        <td class="num">{{this.employeeCount}}</td>
        <td class="num">{{this.hours}}</td>
        <td class="num">{{this.avgRate}}</td>
        <td class="num">{{this.subtotal}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{/if}}

  <div class="totals">
    <table>
      <tr>
        <td>Subtotal</td>
        <td class="num">₹ {{subtotal}}</td>
      </tr>
      {{#if cgstAmount}}
      <tr>
        <td>CGST @ {{halfGstRate}}%</td>
        <td class="num">₹ {{cgstAmount}}</td>
      </tr>
      <tr>
        <td>SGST @ {{halfGstRate}}%</td>
        <td class="num">₹ {{sgstAmount}}</td>
      </tr>
      {{/if}}
      {{#if igstAmount}}
      <tr>
        <td>IGST @ {{gstRate}}%</td>
        <td class="num">₹ {{igstAmount}}</td>
      </tr>
      {{/if}}
      <tr class="grand-total">
        <td>Total</td>
        <td class="num">₹ {{totalAmount}}</td>
      </tr>
    </table>
  </div>

  <div class="amount-words">
    <strong>Amount in words:</strong> {{amountInWords}}
  </div>

  {{#if notes}}
  <div class="annexure-note">
    <strong>Notes:</strong> {{notes}}
  </div>
  {{/if}}

  {{#unless isGeneralInvoice}}
  <div class="annexure-note">
    <strong>Note:</strong> This invoice covers services provided by {{totalEmployees}} employees during the period
    {{periodStart}} to {{periodEnd}}. A detailed employee-wise breakdown is enclosed in the Annexure document
    (available on request or as a separate download).
  </div>
  {{/unless}}

  <div class="footer">
    <div class="bank">
      <strong>Bank Details:</strong> {{bankName}} &nbsp;|&nbsp; A/C: {{bankAccount}} &nbsp;|&nbsp; IFSC: {{bankIfsc}}
    </div>
    <div>Payment terms: Payment due within 30 days of invoice date. Please quote invoice number in all correspondence.
    </div>
    <div style="margin-top: 8px;">This is a computer-generated invoice and does not require a physical signature.</div>
  </div>

  <div class="stamp">
    <div>For <strong>{{companyName}}</strong></div>
    <div style="margin-top: 25px;">
      <span class="signature-line">Authorised Signatory</span>
    </div>
  </div>

</body>

</html>