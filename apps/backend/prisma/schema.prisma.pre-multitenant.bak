generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  HR
  MANAGER
  EMPLOYEE
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(EMPLOYEE)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee     Employee?

  @@map("users")
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

model Employee {
  id             String         @id @default(uuid())
  employeeCode   String         @unique
  firstName      String
  lastName       String
  email          String         @unique
  phone          String?
  department     String?
  designation    String?
  employmentType EmploymentType @default(FULL_TIME)
  dateOfJoining  DateTime
  dateOfLeaving  DateTime?
  isActive       Boolean        @default(true)

  baseSalary     Decimal?       @db.Decimal(12, 2)
  currency       String         @default("INR")

  userId         String?        @unique
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  biometrics     Biometric[]
  faceEmbeddings FaceEmbedding[]
  attendanceLogs AttendanceLog[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("employees")
}

enum BiometricType {
  FINGERPRINT
  FACE
  CARD
  PIN
}

model Biometric {
  id           String        @id @default(uuid())
  employeeId   String
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type         BiometricType
  deviceUserId String
  template     Bytes?
  deviceId     String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())

  @@unique([deviceId, deviceUserId])
  @@index([employeeId])
  @@map("biometrics")
}

model FaceEmbedding {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  embedding  Float[]
  label      String?
  quality    Float?
  createdAt  DateTime @default(now())

  @@index([employeeId])
  @@map("face_embeddings")
}

enum LogDirection {
  IN
  OUT
}

enum LogSource {
  FACE
  FINGERPRINT
  CARD
  PIN
  MANUAL
  MOBILE
}

model AttendanceLog {
  id         String       @id @default(uuid())
  employeeId String
  employee   Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  timestamp  DateTime     @default(now())
  direction  LogDirection
  source     LogSource
  deviceId   String?
  confidence Float?
  scanId     String?      @unique
  notes      String?
  createdAt  DateTime     @default(now())

  @@index([employeeId, timestamp])
  @@index([timestamp])
  @@map("attendance_logs")
}

model AttendanceDay {
  id           String   @id @default(uuid())
  employeeId   String
  date         DateTime @db.Date
  firstIn      DateTime?
  lastOut      DateTime?
  totalMinutes Int      @default(0)
  overtimeMins Int      @default(0)
  lateMins     Int      @default(0)
  status       String   @default("PRESENT")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([date])
  @@map("attendance_days")
}



// ============ PAYROLL ============

model PayrollRun {
  id             String   @id @default(uuid())
  periodStart    DateTime @db.Date
  periodEnd      DateTime @db.Date
  status         String   @default("DRAFT")
  totalGross     Decimal  @default(0) @db.Decimal(14, 2)
  totalNet       Decimal  @default(0) @db.Decimal(14, 2)
  totalEmployees Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  payslips       Payslip[]

  @@unique([periodStart, periodEnd])
  @@map("payroll_runs")
}

model Payslip {
  id              String     @id @default(uuid())
  payrollRunId    String
  payrollRun      PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId      String
  employeeCode    String
  employeeName    String
  email           String

  periodStart     DateTime   @db.Date
  periodEnd       DateTime   @db.Date

  presentDays     Decimal    @db.Decimal(5, 2)
  absentDays      Decimal    @db.Decimal(5, 2)
  halfDays        Decimal    @db.Decimal(5, 2)
  overtimeMins    Int        @default(0)
  lateMins        Int        @default(0)

  grossPay        Decimal    @db.Decimal(12, 2)
  totalDeductions Decimal    @db.Decimal(12, 2)
  netPay          Decimal    @db.Decimal(12, 2)
  currency        String     @default("INR")

  emailedAt       DateTime?
  pdfPath         String?

  lineItems       PayslipLineItem[]

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
  @@map("payslips")
}

model PayslipLineItem {
  id        String  @id @default(uuid())
  payslipId String
  payslip   Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  category  String
  label     String
  amount    Decimal @db.Decimal(12, 2)
  sortOrder Int     @default(0)

  @@index([payslipId])
  @@map("payslip_line_items")
}

// ============ DEVICES ============

model Device {
  id          String   @id @default(uuid())
  name        String
  location    String?
  type        String   @default("CAMERA")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  apiKeys     DeviceApiKey[]

  @@map("devices")
}

model DeviceApiKey {
  id          String   @id @default(uuid())
  deviceId    String
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  keyHash     String   @unique
  label       String?
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([deviceId])
  @@map("device_api_keys")
}
