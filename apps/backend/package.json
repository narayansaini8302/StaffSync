{
  "name": "@attendance/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "prisma generate && tsc && node scripts/copy-templates.js && npx puppeteer browsers install chrome",
    "build:backend": "npm run build",
    "start": "npx prisma db push --skip-generate && npm run seed && node dist/index.js",
    "postinstall": "prisma generate && npx puppeteer browsers install chrome",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "db:setup": "prisma db push && prisma generate && npm run seed"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/handlebars": "^4.0.40",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.17.24",
    "@types/nodemailer": "^8.0.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.0",
    "express": "^5.2.1",
    "handlebars": "^4.7.9",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "prisma": "^5.22.0",
    "puppeteer": "^25.11.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "yauzl": "^3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/yauzl": "^3.4.0",
    "ts-node-dev": "^2.0.0"
  }
}
